# One update run. Triggered by wiser-update.timer, not enabled on its own.
[Unit]
Description=wiser: pull, rebuild and swap
Requires=docker.service
After=docker.service wiser.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wiser
User=wiser
Group=docker
ExecStart=/opt/wiser/deploy/update.sh
TimeoutStartSec=3600
