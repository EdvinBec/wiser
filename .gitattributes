# The repository is edited on Windows and deployed on Linux. Without this, shell scripts and
# unit files get CRLF line endings on checkout and the kernel fails them with a confusing
# "bad interpreter: no such file or directory".
*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf
Dockerfile text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
