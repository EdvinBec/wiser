# ─────────────────────────────────────────────────────────────────────────────
#  wiser — server configuration
#
#  On the server:   cp .env.production.example .env   and fill in every value
#                   marked FILL IN. The file is gitignored; it never leaves the
#                   machine.
#
#  Anything you change here takes effect on the next `deploy/update.sh`, except
#  VITE_API_BASE_URL, which is baked into the frontend bundle at BUILD time and
#  therefore needs the image rebuilt (the update script does that anyway).
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Database ──────────────────────────────────────────────────────────────
# These three CREATE the database on first start. Afterwards the stored password
# is the one the volume was initialised with: changing POSTGRES_PASSWORD here
# will NOT change it inside an existing database. To rotate it later, run
# ALTER USER inside the container.
#
# Use a long random value. Nothing but the backend ever types it.
#   openssl rand -base64 32
POSTGRES_USER=wiser
# FILL IN
POSTGRES_PASSWORD=
POSTGRES_DB=wiser

# Not published at all in production (docker-compose.prod.yml resets it). Left
# here only so the variable exists if you temporarily run the base file alone.
POSTGRES_PORT=5433


# ── 2. Public address ────────────────────────────────────────────────────────
# Your domain, with scheme, no trailing slash. One variable, two jobs: the only
# origin allowed to call the API, and where Google sends people back after
# sign-in. Get it wrong and login fails with a redirect_uri_mismatch.
# FILL IN, e.g. https://urnik.example
Frontend__Url=

# Leave EMPTY. The frontend image proxies /api, /auth and /user to the backend
# itself, so the page and the API share one origin and the browser never makes a
# cross-origin request. Only set an absolute URL if you split the two across
# different hosts.
VITE_API_BASE_URL=

# Host port the site listens on, bound to 127.0.0.1 in production. Point the
# tunnel at this. Change it if something else on the laptop already holds 8080 —
# check with: ss -ltnp | grep 8080
FRONTEND_PORT=8080

# The backend, also loopback-only. Used for `curl` while debugging; the browser
# never touches it directly.
BACKEND_PORT=5013


# ── 3. Authentication ────────────────────────────────────────────────────────
# Signing key for the session tokens this app issues. Must be at least 32 bytes
# and must NOT be the one from development — anything signed with a leaked key
# can be forged.
#   openssl rand -base64 48
# FILL IN
Jwt__Secret=
Jwt__Issuer=wiser-api
Jwt__Audience=wiser-app

# Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# of type "Web application". In that client you must also register, exactly:
#   Authorised JavaScript origin:  https://your-domain
#   Authorised redirect URI:       https://your-domain/signin-google
# FILL IN
Google__ClientId=
# FILL IN
Google__ClientSecret=


# ── 4. Wise Timetable ────────────────────────────────────────────────────────
# School code as it appears in the published timetable URL,
# wise-tt.com/web/<school>/.
WISE_SCHOOL=feri

# Sent on every request to wise-tt.com. A public instance polls them regularly
# from one address, so identify the deployment honestly and leave a contact that
# reaches you. Do not pretend to be a browser.
WISE_USER_AGENT=wiser/1.0 (+https://github.com/EdvinBec/wiser)


# ── 5. Optional: pgadmin ─────────────────────────────────────────────────────
# Only starts with `--profile tools`, and only on 127.0.0.1:5050, so reaching it
# means tunnelling over SSH:
#   ssh -L 5050:127.0.0.1:5050 you@laptop
# It has no default password and refuses to start without one.
# PGADMIN_EMAIL=you@example.com
# PGADMIN_PASSWORD=
