# Copy to .env at the repository root and fill in. .env is gitignored — never commit it.
#
# One file drives both runtimes: docker-compose reads it directly, and a local `dotnet run`
# finds it by walking up from backend/backend (see LoadDotEnvFromAncestors in Program.cs).
# Keeping a second copy anywhere else is how credentials drift apart.

# ── Database ────────────────────────────────────────────────────────────────
# These three create the database container on first run. Change them later and the running
# container keeps the ORIGINAL values: POSTGRES_PASSWORD only applies while the volume is
# being initialised. To genuinely change the password, either ALTER USER inside the database
# or drop the volume (`docker compose down -v`) and lose its data.
POSTGRES_USER=development
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wiser

# Host port the database is published on. 5432 is the PostgreSQL default, but a locally
# installed PostgreSQL service may already own it — in which case the container cannot bind
# and localhost:5432 reaches that other server instead. 5433 keeps them apart.
POSTGRES_PORT=5433

# Where the backend looks for the database. Leave unset for local development (defaults to
# 127.0.0.1); docker-compose overrides it to "database" for the container.
# POSTGRES_HOST=127.0.0.1

# Set this to override the two above with a complete Npgsql connection string. Takes
# precedence over everything, including appsettings.
# DB_CONNECTION_STRING=Host=...;Port=...;Database=...;Username=...;Password=...;

# ── Auth ────────────────────────────────────────────────────────────────────
# The double underscore is how .NET maps an environment variable onto a config section,
# so Jwt__Secret populates Jwt:Secret.
Jwt__Secret=at_least_32_characters_of_random_secret
Jwt__Issuer=wiser-api
Jwt__Audience=wiser-app

# From the Google Cloud console, OAuth 2.0 client of type "Web application".
Google__ClientId=
Google__ClientSecret=

# ── URLs ────────────────────────────────────────────────────────────────────
Frontend__Url=http://localhost:5173

# ── Paths (containers set this themselves; leave unset locally) ─────────────
# LOG_FILE_DIRECTORY=/app/Data/Logs

# ── Wise Timetable ──────────────────────────────────────────────────────────
# School code as it appears in the published timetable URL, wise-tt.com/web/<school>/.
WISE_SCHOOL=feri
# Sent on every request to wise-tt.com. Identify yourself honestly and leave a contact.
WISE_USER_AGENT=wiser/1.0 (+https://github.com/muhamedgit/wiser)
